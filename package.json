{
  "name": "horse-timer-app",
  "version": "1.2.0",
  "description": "Horse racing timer desktop app",
  "main": "main.js",
  "author": "Bet25",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win nsis --x64",
    "publish:win": "electron-builder --win nsis --x64 --publish always",
    "publish:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dk.bet25.horsetimer",
    "productName": "Horse Timer",
    "icon": "build/icon.ico",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Bet25-live",
      "repo": "HorseTiming"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.sports"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
